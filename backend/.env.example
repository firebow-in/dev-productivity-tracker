# Server Configuration
PORT=3000

# GitHub API Credentials
# Generate a Personal Access Token (Classic or Fine-grained) with `repo` read permissions
GITHUB_TOKEN=your_github_personal_access_token_here

# Target Repository to Track (e.g., owner: octocat, repo: Hello-World)
GITHUB_OWNER=octocat
GITHUB_REPO=Hello-World

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=dev_tracker
